# Copy this file to .env on the server. Do not commit real secrets.

# Optional local deploy metadata. GitHub Actions reads the same values from GitHub Secrets.
DEPLOY_HOST=your.server.ip
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_PASSWORD=

# Image pins
XUI_IMAGE=ghcr.io/mhsanaei/3x-ui:v2.9.0
XUI_WRAPPER_IMAGE=proxy-stack-xui:local
MTG_IMAGE=ghcr.io/9seconds/mtg:2.2.4

# Host paths on the VPS
XUI_DB_DIR=/opt/proxy-stack/data/xui/db
XUI_CERT_DIR=/opt/proxy-stack/data/xui/cert
XUI_LOG_DIR=/opt/proxy-stack/data/xui/log
PROVISION_OUTPUT_DIR=/opt/proxy-stack/data/output

# 3x-ui panel. Use a long random password in production.
XUI_ADMIN_USERNAME=admin
XUI_ADMIN_PASSWORD=change_this_to_a_long_random_admin_password
XUI_PANEL_PORT=20530
XUI_PANEL_WEB_BASE_PATH=/admin-8f2d6c1a/
XUI_PANEL_LISTEN_IP=0.0.0.0
XUI_PANEL_TLS_ENABLED=true
XUI_PANEL_CERT_FILE=
XUI_PANEL_KEY_FILE=
XUI_PANEL_CERT_COMMON_NAME=proxy-stack-panel
XUI_PANEL_INSECURE_TLS=true
XUI_ENABLE_FAIL2BAN=true

# Remote firewall bootstrap. Opens SSH, VLESS, MTG, and optionally panel TCP ports.
FIREWALL_AUTO_CONFIG=true
FIREWALL_OPEN_PANEL_PORT=true

# Public address used in generated links. Leave empty to auto-detect from the VPS.
PUBLIC_HOST=

# VLESS Reality inbound.
VLESS_REMARK=vless-reality-main
VLESS_PORT=443
VLESS_CLIENT_EMAIL=main-client
VLESS_CLIENT_FLOW=xtls-rprx-vision
VLESS_REALITY_TARGET=www.cloudflare.com:443
VLESS_REALITY_SERVER_NAMES=www.cloudflare.com,cloudflare.com
VLESS_REALITY_FINGERPRINT=chrome
VLESS_REALITY_SPIDER_X=/
VLESS_CLIENT_LIMIT_IP=0
VLESS_CLIENT_TOTAL_GB=0

# MTProto proxy. Generate a secret with:
# docker run --rm ghcr.io/9seconds/mtg:2.2.4 generate-secret --hex cloudflare.com
MTG_BIND_PORT=8443
MTG_SECRET=change_this_to_a_generated_mtg_secret_hex

TZ=UTC
